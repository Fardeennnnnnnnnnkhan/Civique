# Runtime
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional map provider. Keep `osm` unless a valid Carto key is configured in the web app environment.
NEXT_PUBLIC_MAP_TILE_PROVIDER=osm
REQUIRE_STORAGE_READY=true

# PostgreSQL
# Runtime traffic may use a pooled URL. Migrations must use a direct/session URL.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/civique?schema=public
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/civique?schema=public

# Authentication
# Production secrets must be distinct and contain at least 32 random characters.
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_of_32_or_more_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_of_32_or_more_characters
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters_for_official_totp_secrets

# Private object storage
# Server-side credentials only. Never expose the service-role key through NEXT_PUBLIC_*.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI gateway and provider
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=30000
AI_ANALYSIS_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=30
# Public Civique Socio publishing is disabled by default in production until moderation ownership is approved.
CIVIQUE_SOCIO_ENABLED=false
# Government/channel adapters are fail-closed until a signed authority agreement and provider secret exist.
CIVIQUE_INTEGRATIONS_ENABLED=false
CIVIQUE_WEBHOOK_SECRET=
CIVIQUE_INTEGRATION_APPROVAL_TOKEN=

# Durable worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_DATABASE_POOL_SIZE=5
WORKER_LEASE_MS=60000
WORKER_LEASE_HEARTBEAT_MS=20000
WORKER_SHUTDOWN_GRACE_MS=30000
SLA_EVALUATION_INTERVAL_MS=60000

# Notification providers
# Email remains PENDING_CONFIGURATION when these values are empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Civique <notifications@example.invalid>

# Local orchestration
# Set SKIP_DOCKER=true only when PostgreSQL is already available.
SKIP_DOCKER=false
PYTHON_BIN=python3

# Development-only seeded identities
DEMO_USER_PASSWORD=replace_with_a_strong_12_plus_character_password
