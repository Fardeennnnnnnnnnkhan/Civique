{
  "name": "@civique/worker",
  "version": "1.0.0",
  "description": "Civique durable PostgreSQL job worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --project tsconfig.json src/env.test.ts && ts-node --project tsconfig.json src/queue.test.ts && ts-node --project tsconfig.json src/reportClassification.test.ts && ts-node --project tsconfig.json src/notificationDelivery.test.ts",
    "test:integration:queue": "ts-node --project tsconfig.json src/queue.integration.test.ts",
    "test:integration:classification": "ts-node --project tsconfig.json src/reportClassification.integration.test.ts",
    "test:notification-delivery": "ts-node --project tsconfig.json src/notificationDelivery.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
